# =============================================================================
# Wirtualny Staging – zmienne środowiskowe
# Skopiuj ten plik do `.env` (lokalnie) i uzupełnij wartości.
# Plików `.env*` (poza tym przykładem) NIE commitujemy.
# =============================================================================

# --- Baza danych (Prisma) -----------------------------------------------------
# Lokalnie SQLite. Ścieżka względna liczona od katalogu `prisma/`
# (plik bazy wyląduje w `prisma/data/dev.db`, ignorowanym przez git).
# Produkcyjnie: adres Postgresa, np. postgresql://user:haslo@host:5432/baza
DATABASE_URL="file:./data/dev.db"

# --- Adres serwisu ------------------------------------------------------------
# Publiczny adres strony (bez ukośnika na końcu). Używany w linkach w e-mailach,
# w przekierowaniach Stripe Checkout, w sitemap i metadanych OpenGraph.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Płatności (Stripe Checkout: BLIK, karta, Przelewy24) ----------------------
# Klucz tajny z panelu Stripe (sk_test_... w trybie testowym, sk_live_... na produkcji).
STRIPE_SECRET_KEY=""
# Sekret podpisu webhooka (whsec_...). Lokalnie: `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=""

# --- E-mail (Resend) ----------------------------------------------------------
# Klucz API Resend. Gdy pusty – treść maili jest tylko logowana do konsoli.
RESEND_API_KEY=""
# Nadawca wiadomości (domena musi być zweryfikowana w Resend).
EMAIL_FROM="Wirtualny Staging <kontakt@wirtualnystaging.pl>"
# Adres operatora – tu trafiają powiadomienia „Nowe zamówienie” (domyślnie e-mail z src/lib/site.ts).
EMAIL_ADMIN="kontakt@wirtualnystaging.pl"

# --- Panel administratora -----------------------------------------------------
# Hasło do logowania w /admin. Ustaw długie, losowe hasło.
ADMIN_PASSWORD=""
# Sekret do podpisywania ciasteczka sesji admina (min. 32 losowe znaki),
# np. wygenerowany poleceniem: openssl rand -hex 32
ADMIN_SESSION_SECRET=""

# --- Przechowywanie plików (zdjęcia klientów i wyniki) -------------------------
# `local` – pliki w ./data/uploads/<orderId>/... (rozwój, mały serwer z dyskiem)
# `s3`    – magazyn zgodny z S3 (AWS S3, Cloudflare R2, Backblaze B2, MinIO...)
STORAGE_DRIVER="local"
# Poniższe wymagane tylko przy STORAGE_DRIVER="s3".
# Endpoint usługi (dla AWS S3 można zostawić pusty), np. https://<konto>.r2.cloudflarestorage.com
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Region, np. eu-central-1 (dla R2: auto)
S3_REGION=""
# "true" dla MinIO i dostawców wymagających adresów w stylu ścieżki (bucket w ścieżce URL).
S3_FORCE_PATH_STYLE="false"
# Katalog plików dla STORAGE_DRIVER="local" (domyślnie ./data/uploads).
UPLOADS_DIR="./data/uploads"

# Maksymalny rozmiar pojedynczego wgrywanego zdjęcia w MB.
MAX_UPLOAD_MB=25

# --- Sprzątanie starych plików ---------------------------------------------------
# Sekret dla GET/POST /api/cron/cleanup (nagłówek `Authorization: Bearer <CRON_SECRET>`).
# Usuwa pliki zamówień dostarczonych/anulowanych ponad 30 dni temu oraz tmp/ starsze niż 24 h.
# Alternatywnie z serwera: `npm run cleanup` (np. w cronie raz dziennie).
CRON_SECRET=""

# --- Generowanie wariantów AI (panel operatora) ---------------------------------
# Domyślny dostawca: replicate | openai | gemini. Wystarczy klucz jednego z nich.
# Bez żadnego klucza panel działa – przycisk „Generuj warianty” jest wyłączony, wyniki wgrywasz ręcznie.
AI_PROVIDER="replicate"
# Replicate (https://replicate.com/account/api-tokens) – model edycji obrazu, domyślnie FLUX Kontext Pro.
REPLICATE_API_TOKEN=""
REPLICATE_MODEL="black-forest-labs/flux-kontext-pro"
# OpenAI (https://platform.openai.com/api-keys) – edycja zdjęć modelem gpt-image-1.
OPENAI_API_KEY=""
OPENAI_IMAGE_MODEL="gpt-image-1"
# Opcjonalnie jakość OpenAI: low | medium | high (puste = domyślna dostawcy; wpływa na koszt).
OPENAI_IMAGE_QUALITY=""
# Google Gemini (https://aistudio.google.com/apikey) – modele „Nano Banana”.
GEMINI_API_KEY=""
GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"
# Domyślna liczba wariantów generowanych jednym kliknięciem (1–6).
AI_VARIANTS_PER_PHOTO=3
# Dłuższy bok zdjęcia wysyłanego do API (px) – mniejsze = szybciej i taniej; wynik i tak
# dopasowujemy do proporcji oryginału.
AI_MAX_INPUT_SIDE=2048
# 1 = generowanie synchroniczne (żądanie czeka na wynik, do ~2 min na wariant). Włącz na hostingu
# serverless, jeśli warianty „gubią się” w trakcie generowania w tle. Domyślnie puste (w tle).
AI_SYNC=""
# TYLKO TESTY: AI_PROVIDER="mock" włącza testowego dostawcę (prostokąt na zdjęciu) poza produkcją;
# AI_MOCK_ENABLED=1 pozwala na to także po `next start` (testy E2E). Nigdy na prawdziwym serwerze.
AI_MOCK_ENABLED=""
