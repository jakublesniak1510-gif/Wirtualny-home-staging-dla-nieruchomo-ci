// Wspólny model danych serwisu Wirtualny Staging.
// Lokalnie SQLite (DATABASE_URL="file:./data/dev.db" – ścieżka względem tego pliku),
// produkcyjnie Postgres – wystarczy zmienić `provider` i DATABASE_URL.
// Kwoty zawsze w groszach (Int). Pola JSON trzymamy jako String (zgodność z SQLite).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  NEW
  PAID
  IN_PROGRESS
  READY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  FREE
  REFUNDED
}

model Order {
  id          String      @id @default(cuid())
  /// Losowy token w publicznym adresie /zamowienie/[token] (nie zgadywalny).
  publicToken String      @unique
  status      OrderStatus @default(NEW)

  email   String
  phone   String?
  name    String?
  company String?
  nip     String?

  /// Slug stylu z src/lib/styles.ts
  style          String
  /// JSON: lista slugów dodatków z src/lib/pricing.ts, np. ["usuniecie-mebli"]
  addons         String  @default("[]")
  express        Boolean @default(false)
  photoCount     Int
  /// JSON: wynik calculateOrderPrice() z chwili złożenia zamówienia
  priceBreakdown String
  /// Kwota do zapłaty w groszach (brutto)
  totalAmount    Int
  currency       String  @default("pln")

  paymentStatus         PaymentStatus @default(UNPAID)
  stripeSessionId       String?       @unique
  stripePaymentIntentId String?

  /// Użyty kod pakietu (prepaid), jeśli był
  packageCodeId String?
  packageCode   PackageCode? @relation(fields: [packageCodeId], references: [id], onDelete: SetNull)
  /// Ile kredytów kodu pakietu zarezerwowano dla tego zamówienia (zwalniane przy anulowaniu)
  packageCreditsUsed Int @default(0)
  /// Kod polecenia podany przez klienta (e-mail polecającego)
  referralCode  String?
  /// Kiedy admin wydał nagrodę polecającemu (kod pakietu)
  referralRewardIssuedAt DateTime?
  notes         String?
  /// Notatki wewnętrzne operatora (niewidoczne dla klienta)
  internalNotes String?

  consentTerms   Boolean @default(false)
  consentDigital Boolean @default(false)
  consentHonesty Boolean @default(false)
  consentRights  Boolean @default(false)
  /// Zamówienie z formularza „Darmowa próbka” (kwota 0, bez Stripe)
  isSample       Boolean @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  paidAt      DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?
  /// Kiedy pliki zamówienia usunięto z magazynu (sprzątanie po 30 dniach)
  filesDeletedAt DateTime?

  photos    Photo[]
  revisions RevisionRequest[]

  @@index([status])
  @@index([email])
  @@index([createdAt])
  @@index([isSample, email])
}

model Photo {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Klucz w magazynie plików (src/lib/storage.ts), np. "<orderId>/original/<plik>"
  originalKey  String
  originalName String
  mimeType     String
  /// Rozmiar w bajtach
  size         Int
  width        Int?
  height       Int?

  /// Klucz gotowej wizualizacji (ze znakiem wodnym „wizualizacja”)
  resultKey        String?
  resultUploadedAt DateTime?

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  /// Dodatkowe warianty wyniku (poza głównym resultKey), też ze znakiem wodnym
  results    PhotoResult[]
  /// Warianty wygenerowane przez AI w panelu admina (bez znaku wodnego, tylko dla operatora)
  aiVariants AiVariant[]
  revisions  RevisionRequest[]

  @@index([orderId])
}

/// Dodatkowy wariant gotowej wizualizacji dla jednego zdjęcia (klient dostaje wszystkie).
model PhotoResult {
  id      String @id @default(cuid())
  photoId String
  photo   Photo  @relation(fields: [photoId], references: [id], onDelete: Cascade)

  /// Klucz w magazynie (ze znakiem wodnym „wizualizacja”)
  key       String
  /// Np. "Wariant B", "Jaśniejsza sofa"
  label     String?
  /// "manual" | "ai"
  source    String   @default("manual")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([photoId])
}

/// Wariant wygenerowany przez model AI (src/lib/ai/). Operator wybiera najlepszy i publikuje jako wynik.
model AiVariant {
  id      String @id @default(cuid())
  photoId String
  photo   Photo  @relation(fields: [photoId], references: [id], onDelete: Cascade)

  /// "PENDING" | "RUNNING" | "DONE" | "FAILED"
  status    String  @default("PENDING")
  provider  String
  model     String
  prompt    String
  /// Klucz w magazynie po zakończeniu generowania
  key       String?
  error     String?
  /// Szacowany koszt w groszach (do statystyk)
  costCents Int?
  /// Identyfikator zadania u dostawcy (np. predykcja Replicate)
  externalId String?

  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([photoId])
  @@index([status])
}

/// Zgłoszenie poprawki od klienta (1 bezpłatna runda w ciągu 7 dni – stałe w pricing.ts).
model RevisionRequest {
  id      String  @id @default(cuid())
  orderId String
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  photoId String?
  photo   Photo?  @relation(fields: [photoId], references: [id], onDelete: SetNull)

  message String
  /// "OPEN" | "IN_PROGRESS" | "DONE" | "REJECTED"
  status     String    @default("OPEN")
  /// Odpowiedź operatora widoczna dla klienta
  reply      String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([orderId])
  @@index([status])
}

/// Jednorazowy link logowania do „Moje zamówienia” (hasz tokenu, nie sam token).
model MagicLink {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

model PackageCode {
  id           String    @id @default(cuid())
  code         String    @unique
  /// 1 kredyt = 1 zdjęcie bazowe (dodatki płatne osobno)
  creditsTotal Int
  creditsLeft  Int
  email        String?
  note         String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  orders Order[]
}

model ContactRequest {
  id        String   @id @default(cuid())
  /// "contact" | "office" | "sample"
  type      String
  name      String
  email     String
  phone     String?
  company   String?
  message   String?
  /// JSON z dodatkowymi polami formularza
  payload   String?
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
}
